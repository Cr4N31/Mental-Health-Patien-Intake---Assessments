{
  "expo": {
    "name": "PranatiX",
    "slug": "pranatix",
    "scheme": "pranatix",
    "version": "1.0.0",
    "platforms": ["ios", "android", "web"],
    "icon": "./assets/Logo PranatiX_iconX_whitebackground.png",
    "android": {
      "package": "com.cran3.pranatix",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo_x.png",
        "backgroundImage": "./assets/logo_x.png",
        "monochromeImage": "./assets/logo_x.png",
        "backgroundColor": "#F7FAF8"
      }
    },
    "ios": {
      "bundleIdentifier": "com.cran3.pranatix"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f773b30f-70f3-4daf-921a-c2e6f2237b85"
      }
    },
    "owner": "cran3"
  }
}
